# Copy to .env and fill in. Empty values are ignored.

# Frontier model (writing). Without a key the local `claude` CLI is used.
ANTHROPIC_API_KEY=
WRITE_MODEL=claude-opus-5-5

# Chat model: an OpenAI-compatible endpoint serving the fine-tuned Gemma
# (vLLM, llama.cpp server, Ollama at http://localhost:11434/v1, ...).
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# Optional: answers collected from the chat model offline, {"<user message>": "<reply>"}.
CHAT_ANSWERS_FILE=

# Optional: Jev decision-model routing through OpenRouter. Without it a rule routes.
OPENROUTER_API_KEY=

# Optional: play back a recording of real outputs at a watchable pace.
WW_REPLAY=

PORT=8787
